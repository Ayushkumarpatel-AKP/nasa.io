rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isAuthenticated() && 
             request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isAuthenticated() && 
             request.auth.uid == uid;
    }

    function isValidUser(uid) {
      return isVerifiedUser() && isOwner(uid);
    }

    // USER DATA - Only owner can access their own data
    match /users/{uid} {
      allow read: if isValidUser(uid);
      allow create: if isValidUser(uid) && 
                       request.resource.data.email == request.auth.token.email;
      allow update, delete: if isValidUser(uid);
      
      // User settings subcollection
      match /settings/{document=**} {
        allow read, write: if isValidUser(uid);
      }
      
      // User preferences subcollection
      match /preferences/{document=**} {
        allow read, write: if isValidUser(uid);
      }
    }

    // ANALYTICS DATA - Read-only for verified users
    match /analytics/{document=**} {
      allow read: if isVerifiedUser();
      allow write: if false;  // No direct writes
    }

    // SETTINGS - Restricted
    match /settings/{document=**} {
      allow read, write: if false;  // No direct access
    }

    // SYSTEM DATA - Restricted
    match /system/{document=**} {
      allow read, write: if false;  // No direct access
    }

    // DEFAULT DENY - Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
